generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  bio          String?
  avatarUrl    String?   @map("avatar_url")
  role         String    @default("user") // "user" | "admin" | "owner"
  warnedAt     DateTime? @map("warned_at")
  warnedReason String?   @map("warned_reason")
  bannedAt     DateTime? @map("banned_at")
  bannedReason String?   @map("banned_reason")
  lastActive   DateTime? @map("last_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  forumPosts         ForumPost[]
  forumReplies       ForumReply[]
  sentMessages       Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")
  voiceRooms         VoiceRoom[]
  globalChatMessages GlobalChatMessage[]
  notifications      Notification[]
  materials          Material[]
  pairMembership     PairMember?
  pairMessages       PairMessage[]       @relation("PairMessagesSent")
  replyReminders     ReplyReminder[]     @relation("ReplyRemindersTargeted")
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

model ForumCategory {
  id          String   @id @default(cuid())
  name        String
  description String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  posts ForumPost[]

  @@map("forum_categories")
}

model ForumPost {
  id         String   @id @default(cuid())
  title      String
  content    String
  authorId   String   @map("author_id")
  categoryId String   @map("category_id")
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  author   User          @relation(fields: [authorId], references: [id])
  category ForumCategory @relation(fields: [categoryId], references: [id])
  replies  ForumReply[]

  @@map("forum_posts")
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String
  authorId  String   @map("author_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  author User      @relation(fields: [authorId], references: [id])
  post   ForumPost @relation(fields: [postId], references: [id])

  @@map("forum_replies")
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  createdAt  DateTime @default(now()) @map("created_at")
  read       Boolean  @default(false)

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@map("messages")
}

model VoiceRoom {
  id        String   @id @default(cuid())
  name      String
  createdBy String   @map("created_by")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@map("voice_rooms")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Material {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String   @map("file_url")
  fileType    String   @map("file_type") // "pdf" | "image" | "video" | "word"
  fileName    String   @map("file_name")
  fileSize    Int      @map("file_size")
  uploadedBy  String   @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@map("materials")
}

model GlobalChatMessage {
  id        String   @id @default(cuid())
  content   String
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id])

  @@map("global_chat_messages")
}

// ---------------------------------------------------------------------------
// Berdua - private two-person chat with reply reminders
// ---------------------------------------------------------------------------

model Pair {
  id         String   @id @default(cuid())
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  members   PairMember[]
  messages  PairMessage[]
  reminders ReplyReminder[]

  @@map("pairs")
}

model PairMember {
  id     String @id @default(cuid())
  pairId String @map("pair_id")
  userId String @unique @map("user_id")

  nickname         String?
  remindersEnabled Boolean @default(true) @map("reminders_enabled")
  // Menit setelah pesan pertama yang belum dibales, bertingkat makin gencar.
  reminderLadder   Int[]   @default([30, 120, 360, 1440]) @map("reminder_ladder")
  urgentLadder     Int[]   @default([10, 45, 120]) @map("urgent_ladder")
  // Jam tenang, disimpan sebagai menit dari tengah malam waktu lokal user.
  quietStartMinute Int     @default(1380) @map("quiet_start_minute")
  quietEndMinute   Int     @default(420) @map("quiet_end_minute")
  // Offset zona waktu dalam menit (WIB = 420, WITA = 480, WIT = 540).
  tzOffsetMinutes  Int     @default(420) @map("tz_offset_minutes")

  snoozedUntil DateTime? @map("snoozed_until")
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  pair Pair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pairId, userId])
  @@map("pair_members")
}

model PairMessage {
  id         String    @id @default(cuid())
  pairId     String    @map("pair_id")
  senderId   String    @map("sender_id")
  content    String
  priority   String    @default("normal") // "normal" | "urgent"
  needsReply Boolean   @default(true) @map("needs_reply")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  pair      Pair            @relation(fields: [pairId], references: [id], onDelete: Cascade)
  sender    User            @relation("PairMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  reminders ReplyReminder[]

  @@index([pairId, createdAt])
  @@map("pair_messages")
}

model ReplyReminder {
  id           String    @id @default(cuid())
  pairId       String    @map("pair_id")
  // Pesan paling awal dalam rentetan yang belum dibales.
  messageId    String    @map("message_id")
  targetUserId String    @map("target_user_id")
  step         Int       @default(0)
  dueAt        DateTime  @map("due_at")
  status       String    @default("pending") // "pending" | "sent" | "cancelled" | "skipped"
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  pair    Pair        @relation(fields: [pairId], references: [id], onDelete: Cascade)
  message PairMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  target  User        @relation("ReplyRemindersTargeted", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([targetUserId, status])
  @@map("reply_reminders")
}

model PushSubscription {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?   @map("user_agent")
  failureCount Int       @default(0) @map("failure_count")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
