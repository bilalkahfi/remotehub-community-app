# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_app?schema=public"

# --- Auth -------------------------------------------------------------------
JWT_SECRET="ganti-pakai-string-acak-panjang"
NEXTAUTH_SECRET="ganti-juga"

# --- Alamat aplikasi --------------------------------------------------------
# Web Push wajib HTTPS (kecuali localhost), jadi pakai domain beneran waktu deploy.
APP_URL="https://berdua.domain-lo.com"
NEXT_PUBLIC_APP_URL="https://berdua.domain-lo.com"

# --- Berdua: notifikasi push ------------------------------------------------
# Bikin sekali pakai: npm run berdua:vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:email-lo@contoh.com"

# --- Berdua: pemicu pengingat ----------------------------------------------
# Endpoint /api/berdua/cron/reminders cuma jalan kalau secret ini keisi.
CRON_SECRET="string-acak-lain"
